# Normalize all text files to LF in the repository and on checkout.
* text=auto eol=lf

# Explicitly mark binary files so Git never touches their line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.pdf  binary
*.zip  binary
