# Node modules directory, which contains all the dependencies installed via
# the package manager.
node_modules

# Build output directory, which contains the compiled code and other build
# artifacts.
dist

# The folder where mkcert will store its certificates, these should not be
# committed to the repository.
ssl

# MacOS specific files that are automatically generated by the system.
.DS_Store

# Exclude the VSCode folder but explicitly include settings.json as this
# contains settings that might be useful to share.
.vscode/*
!.vscode/settings.json

# The pnpm content-addressable store used for caching packages locally. This
# is machine-specific and should not be committed to the repository.
.pnpm-store/*